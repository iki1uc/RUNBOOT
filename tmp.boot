BOOT.VERSION=1.0
BOOT.ENTRY=0x7C00
INIT.CPU=real
INIT.MEM=detect
INIT.STACK=0x9000
INIT.DISK=INT13
INIT.VIDEO=INT10.03h
DOOR.ACTION=load(OS.KERNEL)
DOO.READ=INT13
DOO.KERNEL.LBA=1
DOO.KERNEL.SIZE=32KB
RESPO.LOG="BOOT START"
OS.KERNEL="/boot/kernel.bin"
OS.ENTRY=0x1000
243.TIMER=INT1A
243.SYNC=arg.sync
SCORE.TRACE=enable
WETTE.CRC=CRC16
SLIDE.RELOCATE=0x1000
AXIOM.ACTION=jump(OS.ENTRY)
