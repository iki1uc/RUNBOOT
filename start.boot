BOOT.VERSION = 1.0
BOOT.TYPE = minimal‑loader
BOOT.ARCH = x86‑real‑mode
BOOT.SIZE = 512b
BOOT.ENTRY = 0x7C00
INIT.CPU = real‑mode
INIT.MEM = detect(0x413)
INIT.STACK = set(0x9000)
INIT.DISK = BIOS.INT13.enable
INIT.VIDEO = BIOS.INT10.textmode(03h)
DOOR.MODE = single‑entry
DOOR.ACTION = load(OS.KERNEL)
DOOR.FAIL = halt("NO KERNEL")
DOO.READ.SECTOR = BIOS.INT13.read
DOO.READ.OFFSET = 0x0000
DOO.KERNEL.LBA = 1
DOO.KERNEL.SIZE = 32KB
RESPO.LOG = text("BOOT START")
RESPO.ERROR = text("BOOT FAIL")
RESPO.OK = text("BOOT OK")
OS.KERNEL = /boot/kernel.bin
OS.ENTRY = 0x1000
OS.MAP = flat
OS.HANDOFF = jump(OS.ENTRY)
243.TIMER = BIOS.INT1A
243.STAMP = record
243.SYNC = arg.sync
SCORE.TRACE = enable
SCORE.WRITE = /boot/trace.log
SCORE.MODE = sequential
WETTE.CHECKSUM = CRC16
WETTE.KERNEL = verify(OS.KERNEL)
WETTE.FAIL = halt("CRC ERROR")
SLIDE.RELOCATE = kernel.to(0x1000)
SLIDE.MODE = linear
AXIOM.ACTION = jump(OS.ENTRY)
AXIOM.STATE = BOOT.COMPLETE
